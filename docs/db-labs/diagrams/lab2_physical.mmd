erDiagram
  employee |o--o{ attendance : "marked_by"
  lesson_student ||--o| attendance : "lesson_id,student_id"
  subscription |o--o{ attendance : "subscription_id"
  course ||--o{ lesson : "course_id"
  employee ||--o{ lesson : "teacher_id"
  employee |o--o{ lesson : "substitute_id"
  lesson ||--o{ lesson_student : "lesson_id"
  student ||--o{ lesson_student : "student_id"
  parent ||--o| parent_credential : "parent_id"
  parent ||--o{ parent_student : "parent_id"
  student ||--o{ parent_student : "student_id"
  employee |o--o{ student : "created_by"
  employee |o--o{ student_comment : "author_id"
  student ||--o{ student_comment : "student_id"
  employee |o--o{ studio_settings : "updated_by"
  course ||--o{ subscription : "course_id"
  employee |o--o{ subscription : "purchased_by"
  student ||--o{ subscription : "student_id"
  course ||--o{ tariff : "course_id"
  employee |o--o{ work : "printed_by"
  filament |o--o{ work : "filament_id"
  lesson_student ||--o| work : "lesson_id,student_id"
  printer |o--o{ work : "printer_id"
  attendance {
    uuid attendance_id PK "NOT NULL"
    uuid lesson_id FK,UK "NOT NULL"
    uuid student_id FK,UK "NOT NULL"
    varchar(10) status "NOT NULL"
    varchar(15) payment_method ""
    numeric(10_2) amount "NOT NULL"
    numeric(5_2) discount_percent "NOT NULL"
    uuid subscription_id FK ""
    boolean print_enabled "NOT NULL"
    numeric(10_2) print_price ""
    uuid marked_by FK ""
    timestamptz marked_at "NOT NULL"
  }
  course {
    smallint course_id PK "NOT NULL"
    varchar(60) name UK "NOT NULL"
    varchar(10) direction "NOT NULL"
    smallint age_min "NOT NULL"
    smallint age_max "NOT NULL"
    numeric(10_2) online_print_price ""
    boolean active "NOT NULL"
  }
  employee {
    uuid employee_id PK "NOT NULL"
    varchar(255) email UK "NOT NULL"
    varchar(50) last_name "NOT NULL"
    varchar(50) first_name "NOT NULL"
    varchar(20) role "NOT NULL"
    boolean active "NOT NULL"
    text photo_url ""
    timestamptz created_at "NOT NULL"
  }
  filament {
    smallint filament_id PK "NOT NULL"
    varchar(20) material UK "NOT NULL"
    varchar(30) color UK "NOT NULL"
    numeric(8_2) price_per_kg "NOT NULL"
    boolean active "NOT NULL"
  }
  lesson {
    uuid lesson_id PK "NOT NULL"
    smallint course_id FK "NOT NULL"
    uuid teacher_id FK "NOT NULL"
    uuid substitute_id FK ""
    uuid series_id ""
    date lesson_date "NOT NULL"
    time start_time ""
    smallint duration_minutes "NOT NULL"
    varchar(20) format "NOT NULL"
    varchar(30) room ""
    varchar(200) theme "NOT NULL"
    boolean extra_service "NOT NULL"
    boolean print_default "NOT NULL"
    boolean completed "NOT NULL"
    numeric(10_2) payroll_amount "NOT NULL"
    numeric(10_2) price_amount "NOT NULL"
  }
  lesson_student {
    uuid lesson_id PK,FK "NOT NULL"
    uuid student_id PK,FK "NOT NULL"
  }
  parent {
    uuid parent_id PK "NOT NULL"
    varchar(15) phone UK "NOT NULL"
    varchar(50) last_name ""
    varchar(50) first_name ""
    boolean active "NOT NULL"
    timestamptz last_login_at ""
    timestamptz created_at "NOT NULL"
  }
  parent_credential {
    uuid parent_id PK,FK "NOT NULL"
    text password_hash "NOT NULL"
    timestamptz password_set_at "NOT NULL"
    smallint failed_attempts "NOT NULL"
    timestamptz locked_until ""
  }
  parent_student {
    uuid parent_id PK,FK "NOT NULL"
    uuid student_id PK,FK "NOT NULL"
    varchar(20) relation "NOT NULL"
    timestamptz created_at "NOT NULL"
  }
  printer {
    smallint printer_id PK "NOT NULL"
    varchar(60) name UK "NOT NULL"
    numeric(6_1) power_watts "NOT NULL"
    numeric(8_2) depreciation_per_hour "NOT NULL"
    boolean active "NOT NULL"
  }
  student {
    uuid student_id PK "NOT NULL"
    varchar(50) last_name "NOT NULL"
    varchar(50) first_name "NOT NULL"
    date birthday ""
    varchar(20) phone ""
    text notes ""
    text photo_url ""
    boolean active "NOT NULL"
    uuid created_by FK ""
    timestamptz created_at "NOT NULL"
  }
  student_comment {
    uuid comment_id PK "NOT NULL"
    uuid student_id FK "NOT NULL"
    uuid author_id FK ""
    text body "NOT NULL"
    timestamptz created_at "NOT NULL"
  }
  studio_settings {
    boolean id PK "NOT NULL"
    date calc_start_date ""
    numeric(6_2) electricity_tariff "NOT NULL"
    numeric(5_2) filament_waste_percent "NOT NULL"
    uuid updated_by FK ""
    timestamptz updated_at "NOT NULL"
  }
  subscription {
    uuid subscription_id PK "NOT NULL"
    uuid student_id FK "NOT NULL"
    smallint course_id FK "NOT NULL"
    smallint total_lessons "NOT NULL"
    smallint remaining_lessons "NOT NULL"
    numeric(10_2) total_price "NOT NULL"
    varchar(10) payment_method ""
    varchar(10) status "NOT NULL"
    date purchased_at "NOT NULL"
    uuid purchased_by FK ""
  }
  tariff {
    integer tariff_id PK "NOT NULL"
    smallint course_id FK,UK "NOT NULL"
    varchar(20) tariff_type UK "NOT NULL"
    numeric(10_2) teacher_pay "NOT NULL"
    numeric(10_2) lesson_price "NOT NULL"
    numeric(10_2) subscription_price ""
  }
  work {
    uuid work_id PK "NOT NULL"
    uuid lesson_id FK,UK "NOT NULL"
    uuid student_id FK,UK "NOT NULL"
    text photo_url ""
    boolean is_trial "NOT NULL"
    boolean printed "NOT NULL"
    uuid printed_by FK ""
    timestamptz printed_at ""
    smallint printer_id FK ""
    smallint filament_id FK ""
    numeric(7_1) weight_g ""
    smallint print_minutes ""
  }
