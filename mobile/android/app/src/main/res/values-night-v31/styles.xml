<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash: the robot on the logo navy. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/splash_robot</item>
    </style>
    <!-- Behind the Flutter UI once it is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/screen</item>
    </style>
</resources>
